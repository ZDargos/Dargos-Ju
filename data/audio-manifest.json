  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "e8e3ed31bab180b0": {
  "lang": "zh",
  "text": "让我想一想。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "e912b86f8e97e094": {
  "lang": "zh",
  "text": "我的身体不舒服，很想吐。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "ea1a32b9745cd60c": {
  "lang": "zh",
  "text": "我爱你！我的心是你一个人的。",
