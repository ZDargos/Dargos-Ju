  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "e66aa59ddd8a8550": {
  "lang": "zh",
  "text": "我在中国呆过。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "e67fbf800a8b4664": {
  "lang": "zh",
  "text": "我的马很胖。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "e793bb671ad2a128": {
  "lang": "en",
  "text": "I will come over right away.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "e84b1395a8d21f98": {
  "lang": "zh",
  "text": "早上十点半我吃了一个半面包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "ea1a32b9745cd60c": {
  "lang": "zh",
  "text": "我爱你！我的心是你一个人的。",
