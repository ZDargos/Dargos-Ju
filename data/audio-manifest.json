{
 "013f5c1ebc45c2a0": {
  "lang": "en",
  "text": "A: Have you said such things before? B: I have.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "0195dca49ff319e8": {
  "lang": "zh",
  "text": "我才上来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "025425db01d78fae": {
  "lang": "zh",
  "text": "电话在桌子上吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "02a075b603d8c870": {
  "lang": "en",
  "text": "I let my son speak.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "036f68558b1cb554": {
  "lang": "zh",
  "text": "我早上骂了我的儿子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "03caaa508b092e64": {
  "lang": "zh",
  "text": "我找了我的儿子半年了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "049d8b01e3f37e14": {
  "lang": "zh",
  "text": "我骂过我的儿子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "069bcaecb93b5d7a": {
  "lang": "en",
  "text": "Will you come over and look at my wooden spoon?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "0745a08fa10c91fa": {
  "lang": "en",
  "text": "Should I come down?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "077f97214ef1d634": {
  "lang": "zh",
  "text": "我和儿子过日子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "07e1923266649a6e": {
  "lang": "zh",
  "text": "桌子上有几百只虫子！",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "090ec09727d77594": {
  "lang": "en",
  "text": "I came down.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "0a5ee4f5421a7fe0": {
  "lang": "zh",
  "text": "三个人来自中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "0b065bcaadcdf0c8": {
  "lang": "zh",
  "text": "我的电话几百块，但是我儿子的电话几千块。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "0c6892b9ae9467fc": {
  "lang": "en",
  "text": "My son was scared stiff.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "0cde1a696a101a00": {
  "lang": "zh",
  "text": "儿子的电话在桌子下。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "0de6f941ef0d5d68": {
  "lang": "en",
  "text": "A: Do you want to rest? B: Yes. A: What time do you want to rest? B: I want to rest from 1:30 to 3:00. I want to rest for one and a half hours.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "1083af7f4f79e4d8": {
  "lang": "zh",
  "text": "我马上上来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "11256b016e349188": {
  "lang": "en",
  "text": "You always eat rice.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "1188dcae6db452ac": {
  "lang": "en",
  "text": "My horse is fat.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "11e862641e521da8": {
  "lang": "zh",
  "text": "我明白你说的话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "123c82efd67fa44c": {
  "lang": "en",
  "text": "I vomited.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "1325fe77db1ef9dc": {
  "lang": "zh",
  "text": "我吐了一个早上。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "14c818671465cd14": {
  "lang": "zh",
  "text": "我想你了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "15e2b4e0b45f1a00": {
  "lang": "zh",
  "text": "电话在桌子下。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "1633be039d961abc": {
  "lang": "en",
  "text": "I understand what you said.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "16e2d58706733df6": {
  "lang": "zh",
  "text": "你过来看一下我的木勺子，好吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "171876ee9f616c00": {
  "lang": "en",
  "text": "My son's phone is on the table.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "177e701a3dfe3498": {
  "lang": "en",
  "text": "One of my sons and I will come over in the morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "17f31a8776707042": {
  "lang": "zh",
  "text": "你的家里有几个人？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "186b622bb24b79a0": {
  "lang": "zh",
  "text": "我才下来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "1a0ec6b5ff395140": {
  "lang": "zh",
  "text": "A:我的电话在桌子上吗？B:不，在桌子下。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "1ed240bf7391caaa": {
  "lang": "en",
  "text": "Are you afraid of the sun?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "20403190f0a31394": {
  "lang": "en",
  "text": "A: Have you stayed in China before? B: I stayed there for a year.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "20a0673a55667c30": {
  "lang": "zh",
  "text": "我才来中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "2110e3d8a71b7328": {
  "lang": "en",
  "text": "I've been in China for a few months.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "21d06ca7e3a79f90": {
  "lang": "zh",
  "text": "我明年来中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "22768f18ce1350dc": {
  "lang": "en",
  "text": "This table of food smells great.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "22ab5dc2e0b1f400": {
  "lang": "en",
  "text": "A: Do you have a phone? B: I have one phone.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "22d7b478d00b99d4": {
  "lang": "en",
  "text": "Look, this is the cell phone I bought.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "22e15ff7abb865dc": {
  "lang": "en",
  "text": "My son wants to eat noodles in the morning, and he doesn't want to eat bread.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "238afd449a565450": {
  "lang": "zh",
  "text": "我和一个儿子早上过来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "23d523d8322eb39c": {
  "lang": "zh",
  "text": "我用勺子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "24d2617ca2a2efb0": {
  "lang": "en",
  "text": "My cell phone can take photos.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "26b44977a4935cd8": {
  "lang": "zh",
  "text": "你上来吧。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "27797ad900c77054": {
  "lang": "en",
  "text": "A: How many months have you been in China? B: One month.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "28cd03cb88d05ad4": {
  "lang": "en",
  "text": "I have scolded my son.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "29e0278e24583f90": {
  "lang": "zh",
  "text": "A：你的儿子怕你吗？B：对！他很怕我。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "2a5af2152c473498": {
  "lang": "en",
  "text": "I scolded my son this morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2ac078b22bc1c060": {
  "lang": "en",
  "text": "I came to China by plane.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2c0cb8ab1c08d8f8": {
  "lang": "en",
  "text": "He and I are not the same.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2daef43f4383d9dc": {
  "lang": "en",
  "text": "I worry about you very much.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2e8a28ac15fe6188": {
  "lang": "en",
  "text": "My son is very afraid of me.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2e9dee59348e56c8": {
  "lang": "en",
  "text": "Please write down what I say.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2f115ada51c7dae4": {
  "lang": "en",
  "text": "Write down my phone number.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "2f5d00068e469fc8": {
  "lang": "zh",
  "text": "A：你想休息吗？B：我不想休息，我想吃面包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "2fa7830f88de4bf0": {
  "lang": "en",
  "text": "I'm about to come to China.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "309d49e6fc52e0a8": {
  "lang": "en",
  "text": "A: Do you miss me? B: I don't miss you.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "30a2fc4d00f046f0": {
  "lang": "en",
  "text": "He is in China.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "32cfe62268e8e754": {
  "lang": "en",
  "text": "I came by car.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "330569ce422e0114": {
  "lang": "zh",
  "text": "我用本子拍了一下我的儿子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "331c8a1f6c104ac8": {
  "lang": "en",
  "text": "He only understands his own words.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "33c29032fd2e28e0": {
  "lang": "zh",
  "text": "他来自中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3820496ab330a1c4": {
  "lang": "zh",
  "text": "A:你来中国几个月了？ B: 一个月了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "38a8ac867cdc5ae4": {
  "lang": "en",
  "text": "I wrote down your phone number.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "39a84ae7879605d0": {
  "lang": "zh",
  "text": "我马上来中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "39f35aa5a2ac5efc": {
  "lang": "zh",
  "text": "我在看书。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3a24791aab768e38": {
  "lang": "en",
  "text": "A: Do you eat bread in the afternoon? B: I do.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "3a3f14845323352a": {
  "lang": "zh",
  "text": "A: 你有手机吗？B: 有！",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3af36def95bcb150": {
  "lang": "zh",
  "text": "我的儿子很怕我。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3ba73d6fae26a750": {
  "lang": "zh",
  "text": "我想坐下来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3c563f2f711dc4f4": {
  "lang": "zh",
  "text": "他吐在地上。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3c7c4e95df3bd3dc": {
  "lang": "zh",
  "text": "我的电话卡了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3cbefc1d739d1de4": {
  "lang": "en",
  "text": "Let me think for a moment.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "3d56f990fbd95234": {
  "lang": "zh",
  "text": "我坐在桌子上。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3d85635db0238c00": {
  "lang": "en",
  "text": "I'm eating at the table.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "3dabcafc27e69652": {
  "lang": "en",
  "text": "A: Did you write down my phone number? B: Yes, I did. A: If you come to China next year, come find me!",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "3e6b3a03a5280e94": {
  "lang": "en",
  "text": "I vomited in the morning, but not in the afternoon.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "3f368737c7858c44": {
  "lang": "zh",
  "text": "我的口很干。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3f7dfb08d8182214": {
  "lang": "zh",
  "text": "我是坐车来的。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "3fe53595c18e59f4": {
  "lang": "zh",
  "text": "电话在桌子上。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "401076f24744ff18": {
  "lang": "zh",
  "text": "A：你的手白吗？B：我的手不白。A：你儿子的手白吗？B：我儿子的手很白。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "41cfd2dc2058e3e4": {
  "lang": "zh",
  "text": "上来了一个人。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "41d0bd345d2a6ba0": {
  "lang": "zh",
  "text": "三个月来，我没有吃过米饭。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "42bf7320ffcc476c": {
  "lang": "zh",
  "text": "你看，这是我买的手机。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "432bf1e8ed640bec": {
  "lang": "zh",
  "text": "A:你在中国呆过吗？B:呆过一年。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "464a196439fa1598": {
  "lang": "zh",
  "text": "我用勺子吃面或面包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "46be307fe46124de": {
  "lang": "zh",
  "text": "他的电话你记下来了吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "46f7ee9ef9a89594": {
  "lang": "zh",
  "text": "A:你有几个儿子？B:我只有一个儿子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "47d9ec45cd372c20": {
  "lang": "zh",
  "text": "A：你和你的儿子坐过飞机吗？B：我坐过，但是我的儿子没坐过。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4842bea48ea75060": {
  "lang": "en",
  "text": "I gave my son a pat with the notebook.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "487f48977264960c": {
  "lang": "zh",
  "text": "我是中国人。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4a14aac56f1ad466": {
  "lang": "en",
  "text": "Is the phone under the table?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "4aa07c0818261788": {
  "lang": "zh",
  "text": "儿子总是记不住我说的话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4b1ab5449ba134b0": {
  "lang": "zh",
  "text": "我马上过来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4bb537d57ba25f78": {
  "lang": "zh",
  "text": "我找不到我的包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4c65461a055ff5c8": {
  "lang": "zh",
  "text": "我的儿子早上想吃面，不想吃面包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4ce5e45fe994cd26": {
  "lang": "en",
  "text": "How many people are in your family?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "4d292c66dd0e4b68": {
  "lang": "zh",
  "text": "面包很好吃。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "4d2cb0439591fbf0": {
  "lang": "en",
  "text": "He comes from China.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "4e5426d8af064830": {
  "lang": "zh",
  "text": "我坐在桌子上吃饭。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "503e14156e2d4104": {
  "lang": "zh",
  "text": "我来中国几个月了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "504d7fa3914100c0": {
  "lang": "zh",
  "text": "我的电话很旧。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "50b9af6896bbfc54": {
  "lang": "zh",
  "text": "我吐了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "511e32f7b8f9595e": {
  "lang": "en",
  "text": "What are you doing?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "5141c84dac7bef2c": {
  "lang": "zh",
  "text": "我上来了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "5415b0850d423498": {
  "lang": "en",
  "text": "My son ate a few pieces of bread in the morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "541bd5b2145c0c88": {
  "lang": "en",
  "text": "For three months, I have not eaten rice.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "5422d79121e36e94": {
  "lang": "en",
  "text": "The horse ate some noodles at noon.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "5556f8a7722712dc": {
  "lang": "en",
  "text": "My stomach hurts a lot.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "556d6d7c0ed1e6d8": {
  "lang": "zh",
  "text": "他只明白自己的话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "55cca6a057314ac8": {
  "lang": "en",
  "text": "He doesn't understand his own words.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "55d6266d8ee2cf56": {
  "lang": "en",
  "text": "You broke my heart!",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "56dedc99e2812878": {
  "lang": "zh",
  "text": "请记一下我的话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "5877db4400e3f900": {
  "lang": "en",
  "text": "I have a cell phone.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "589695765a312f10": {
  "lang": "zh",
  "text": "我身上有一个白点。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "58c0ae856a398d30": {
  "lang": "en",
  "text": "Bread is delicious.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "5a0fd5b0f1780c60": {
  "lang": "zh",
  "text": "你总是吃米饭。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "5b04c57d602f4646": {
  "lang": "en",
  "text": "A: Should my son and I come over in the morning? B: No, come over in the afternoon!",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "5b5a7aaab97412dc": {
  "lang": "zh",
  "text": "A：你想休息吗？B：对。A：你想几点休息？B：我想一点半到三点休息。我想休息一个半小时。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "5ccb15daeaf9114c": {
  "lang": "zh",
  "text": "我的儿子上午骂了我的马。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "6047d1fea23aa6da": {
  "lang": "zh",
  "text": "A: 我和儿子上午过来吗？B: 不，下午过来吧！",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "644f5a9987ea9cd4": {
  "lang": "en",
  "text": "I have the same kind of phone as my son.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "657622a74e3758dc": {
  "lang": "en",
  "text": "My name is Bread.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "676400b0af778bdc": {
  "lang": "en",
  "text": "I use a spoon to eat noodles or bread.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "67e4251f9dfff900": {
  "lang": "en",
  "text": "This is a cell phone.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "6905824a7dc571b4": {
  "lang": "en",
  "text": "I sat for one hour.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "6bac93d0645c2846": {
  "lang": "zh",
  "text": "电话在桌子下吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "6c767ae753417140": {
  "lang": "zh",
  "text": "你记一下我的电话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "6ce92df7fa0e7430": {
  "lang": "zh",
  "text": "我有我儿子的这种电话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "6cf409a98c76c33c": {
  "lang": "en",
  "text": "A: Have you and your son taken a plane before? B: I have, but my son has not.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "70e747b6d8c2045a": {
  "lang": "en",
  "text": "There are hundreds of bugs on the table!",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "70f98891b313d3a8": {
  "lang": "en",
  "text": "I've been in China for over ten years.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "71d44cdd7fea0b78": {
  "lang": "en",
  "text": "I just came.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "72cb85e477e865dc": {
  "lang": "en",
  "text": "A: Do you want to rest? B: I don't want to rest; I want to eat bread.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "72d5bd1fbabaf928": {
  "lang": "en",
  "text": "A: How many pieces of bread did you eat? B: Three.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "731398e694c80e94": {
  "lang": "en",
  "text": "I want to rest in the afternoon.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "74adb5ffdb9ba498": {
  "lang": "en",
  "text": "I vomited the whole morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7556436a12ff1ac4": {
  "lang": "zh",
  "text": "我很担心你。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "75ca2afab58e03c8": {
  "lang": "zh",
  "text": "我叫面包。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "75ebcbb84747aa6c": {
  "lang": "zh",
  "text": "桌子上有几个盘子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "765795fffb2f136c": {
  "lang": "zh",
  "text": "你看，这是我才买的手机。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "77e8d190a1b88b18": {
  "lang": "en",
  "text": "A: Is the entrance messy? B: The entrance is not messy in the morning; in the afternoon it is very messy.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "78aacfb8872246d0": {
  "lang": "zh",
  "text": "我马上下来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "78cf91587037c6f0": {
  "lang": "en",
  "text": "He lives in China.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7930bbf8efec040c": {
  "lang": "zh",
  "text": "这是一个手机。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "7a0a9986632c1588": {
  "lang": "en",
  "text": "I don't have a notebook on me.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7a1896f3a1e4e594": {
  "lang": "en",
  "text": "I just came down.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7a3bd2d065d7ea14": {
  "lang": "en",
  "text": "I want to sit down.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7c1be0520f06e43c": {
  "lang": "en",
  "text": "One person came up.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7c9371156b7d22d4": {
  "lang": "en",
  "text": "I only worry about my son.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7ca901c1a52b8f14": {
  "lang": "en",
  "text": "My three sons and I will come next year.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7d7ca445d52e4c4e": {
  "lang": "zh",
  "text": "你的马胖吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "7d7ddce2fa457046": {
  "lang": "zh",
  "text": "我下来吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "7e1b3d2e566d219c": {
  "lang": "zh",
  "text": "A:你吃了几个面包？ B:三个。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "7f6208be191faab8": {
  "lang": "en",
  "text": "My son is sitting on the table, talking.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "7f94eeae7ce5083c": {
  "lang": "en",
  "text": "I don't feel well, and I really feel like throwing up.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "80def582ff5759b4": {
  "lang": "en",
  "text": "I worry about Grandpa's health.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "81ed1651615e6c00": {
  "lang": "en",
  "text": "I'm sitting on the table.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "826126ecbdf39e94": {
  "lang": "en",
  "text": "I am at home in the morning and afternoon.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "82c5970b422a6c00": {
  "lang": "en",
  "text": "My son's phone is under the table.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "84b82bd6cd983498": {
  "lang": "en",
  "text": "I always eat noodles in the morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "8648716b154d6798": {
  "lang": "zh",
  "text": "他不明白他自己的话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "88a30a45edcabf94": {
  "lang": "en",
  "text": "I've been looking for my son for half a year.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "891ca69b2f36df54": {
  "lang": "en",
  "text": "A: How many sons do you have? B: I only have one son.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "893332dfdf8851dc": {
  "lang": "zh",
  "text": "我身上没有本子。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "8a95647fdf7a03aa": {
  "lang": "zh",
  "text": "A: 你记下我的电话了吗？B: 对，记下了。A: 明年你来中国的话，来找我吧！",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "8ab0ba6c222a6c00": {
  "lang": "en",
  "text": "The phone is under the table.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "8ad29acb90287408": {
  "lang": "en",
  "text": "Please come down and look for me.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "8d6cf7ed271f2268": {
  "lang": "zh",
  "text": "我和三个儿子明年来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "8dd8dbf07707bda2": {
  "lang": "en",
  "text": "Should I come up?",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "8e2977b9005d06e0": {
  "lang": "zh",
  "text": "他在中国。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "90dcf9dc36509b10": {
  "lang": "zh",
  "text": "请你下来找我一下。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "90eea3c0204637d4": {
  "lang": "en",
  "text": "Look, this is the cell phone I just bought.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9214066a4a551240": {
  "lang": "zh",
  "text": "他和我不一样。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "941a41824409b404": {
  "lang": "zh",
  "text": "我早上和下午在家。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "941e339de5c7eb88": {
  "lang": "zh",
  "text": "我的手机旧了，我想买iphone。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "94420050a7034e30": {
  "lang": "zh",
  "text": "A：我过来吗？B : 过来吧！A: OK！我马上过来。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "94d5da92cd2541d8": {
  "lang": "zh",
  "text": "我说话，但是我的儿子不说话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "94f757fb94401ce8": {
  "lang": "zh",
  "text": "A: 你下午吃面包吗？B: 我吃。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "996e3d53dff2a2a4": {
  "lang": "zh",
  "text": "休息日我总是休息，不干别的。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "99880acc9fa734e0": {
  "lang": "en",
  "text": "My mouth is very dry.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9a75dd4ff211e6d4": {
  "lang": "en",
  "text": "I live with my son.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9ac9ab1d480b34f8": {
  "lang": "zh",
  "text": "我的手机能拍照片。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "9b2fa4e1861cec8c": {
  "lang": "en",
  "text": "I love myself.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9bf5a9709b3ac200": {
  "lang": "en",
  "text": "I have three types of tables.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9efeb4b611f733de": {
  "lang": "zh",
  "text": "你怕晒吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "9f61cfc438bcbbf0": {
  "lang": "en",
  "text": "Three people come from China.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "9fbb794caff8083e": {
  "lang": "zh",
  "text": "桌子上的勺子是你的吗？",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a0584a575b78313c": {
  "lang": "en",
  "text": "Come up.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "a0a58e054a226b6a": {
  "lang": "en",
  "text": "A: Do you have a cell phone? B: Yes!",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "a0a870947bdf9962": {
  "lang": "zh",
  "text": "你伤了我的心！",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a1b8ffb52a1c0354": {
  "lang": "en",
  "text": "My phone is very old.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "a1d0c108cbe9a9dc": {
  "lang": "zh",
  "text": "我过来了。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a29f057c57e540c8": {
  "lang": "zh",
  "text": "我让我的儿子说话。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a2cd037565e31750": {
  "lang": "en",
  "text": "A: Are your hands white? B: My hands are not white. A: Are your son's hands white? B: My son's hands are very white.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "a2eda4606f1410fc": {
  "lang": "zh",
  "text": "我认识你。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a58963796b869560": {
  "lang": "zh",
  "text": "周三是我的休息日。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a7c306bb8b431ab4": {
  "lang": "zh",
  "text": "我坐飞机来中国 。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "a87949ac3dee3c3c": {
  "lang": "en",
  "text": "When I eat bread, I always vomit.",
  "source": "neural",
