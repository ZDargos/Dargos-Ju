  "text": "我有一个手机。",
  "source": "neural",
  "voice": "zh-CN-XiaoxiaoNeural+zh-CN-YunxiNeural"
 },
 "f450f97b6420b498": {
  "lang": "en",
  "text": "My son scolded my horse this morning.",
  "source": "neural",
  "voice": "en-US-AvaNeural+en-US-AndrewNeural"
 },
 "f7d864de2901c614": {
